{
  "$description": "Admiral design tokens, taken from designs/prototype. Colors are hex; sizes are CSS px.",
  "color": {
    "ink": "#14304A",
    "inkDeep": "#0B1F33",
    "navyPanel": "#21486B",
    "navyBorder": "#3A6489",
    "ocean": "#29B2C2",
    "oceanLight": "#5FCFD9",
    "foam": "#DDF7F3",
    "ripple": "#9BEFF0",
    "sand": "#F3D9A4",
    "grass": "#8ACB68",
    "tree": "#4FA85A",
    "stone": "#E4D6B8",
    "rock": ["#8E9AA6", "#A7B2BC", "#7C8996", "#9AA5AF"],
    "wood": "#A0613A",
    "woodDark": "#8E5331",
    "pier": "#E0A86E",
    "parchment": "#FFF6E3",
    "parchmentLight": "#FFFDF6",
    "sidebar": "#FFF1CF",
    "panel": "#FFFAEE",
    "sunny": "#FFC23D",
    "selected": "#FFF0B8",
    "coral": "#FF7A59",
    "attentionPlaque": "#FFD9CC",
    "attentionBorder": "#C2412A",
    "success": "#9BE08A",
    "mint": "#6FE3C8",
    "textMuted": "#3E5870",
    "textOnDark": "#F4EEDF",
    "textOnDarkMuted": "#BFD7EA",
    "terminalBg": "#0E2235",
    "terminalSys": "#7FA6C4",
    "terminalAgent": "#F4EEDF",
    "terminalTool": "#6FE3C8",
    "terminalYou": "#FFC23D"
  },
  "fleet": {
    "$description": "Fleet colors in assignment order. ink is the text color on that fill.",
    "sequence": [
      { "name": "blue", "color": "#3366E0", "ink": "#FFFFFF" },
      { "name": "orange", "color": "#F28C28", "ink": "#14304A" },
      { "name": "violet", "color": "#7A5AF0", "ink": "#FFFFFF" },
      { "name": "teal", "color": "#1F9E8C", "ink": "#FFFFFF" },
      { "name": "rose", "color": "#E2447A", "ink": "#FFFFFF" }
    ]
  },
  "harness": {
    "$description": "Placeholder flag colors until official logos are loaded.",
    "claude": { "flag": "#FF7A59", "ink": "#14304A", "placeholder": "Cl" },
    "copilot": { "flag": "#7A5AF0", "ink": "#FFFFFF", "placeholder": "Co" },
    "codex": { "flag": "#1F3B57", "ink": "#FFFFFF", "placeholder": "Cx" }
  },
  "source": {
    "jira": "#2F6FEB",
    "github": "#14304A",
    "linear": "#6B4BE0"
  },
  "bot": ["#7FC8FF", "#FFC23D", "#9BE08A", "#FF9A7A", "#C9B6FF", "#FFF6E3", "#6FE3C8"],
  "font": {
    "display": "'Bricolage Grotesque', 'Helvetica Neue', sans-serif",
    "body": "'Archivo', 'Helvetica Neue', sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, monospace",
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Archivo:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap"
  },
  "shape": {
    "outline": 2.5,
    "outlineHeavy": 3,
    "radiusCard": 12,
    "radiusPanel": 16,
    "radiusDialog": 24,
    "pressShadow": "0 3px 0 #14304A",
    "minTouchTarget": 44
  },
  "size": {
    "ship": { "width": 100, "height": 96 },
    "crewBoat": { "width": 52, "height": 46 },
    "mooredShip": { "width": 56, "height": 54 },
    "sidebarBasis": 300,
    "marinaColumnBasis": 290,
    "marinaHeight3Docks": 300,
    "marinaHeight2Docks": 240,
    "pierWidth": 164
  },
  "motion": {
    "bob": "3.2s ease-in-out infinite, ±5px, ±1.8deg",
    "flagWave": "1.6s ease-in-out infinite (0.32s when needs you)",
    "shake": "1.3s cycle, shake in the first 46%",
    "sailIn": "1.5s cubic-bezier(.2,.9,.25,1.1), 0.7s delay",
    "leaveDock": "1.1s ease-in, toward the marina mouth, fade out",
    "arriveDock": "1s ease-out fade and scale in, ~0.8s after leaving",
    "crewPop": "0.6s cubic-bezier(.3,1.6,.5,1)",
    "flotillaFlyIn": "0.55s, 90ms stagger",
    "reducedMotion": "all of the above off under prefers-reduced-motion"
  }
}
