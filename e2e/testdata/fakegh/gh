#!/bin/sh
# Fake `gh` for the GitHub plugin's e2e test. A test puts this folder first on
# Admiral's PATH and steers it through $FAKEGH_DIR, a folder the test owns.
#
# It records every call in $FAKEGH_DIR/calls/<call>/:
#   argv         the arguments, each followed by a NUL byte
#   env          GH_TOKEN, GITHUB_TOKEN, GH_ENTERPRISE_TOKEN,
#                GITHUB_ENTERPRISE_TOKEN, GH_NO_UPDATE_NOTIFIER,
#                GH_PROMPT_DISABLED, GH_REPO, GH_HOST, every GIT_CONFIG_* and the marker variables FLEET_MARK,
#                ADMIRAL_BASE and ADMIRAL_OVER (a test puts them in a
#                fleet's env or in Admiral's own) as
#                NAME=value lines; a variable that was not set has no line
#   cwd          the working directory the call ran in
#
# It answers twelve kinds of call and nothing else (anything else exits 2):
#
#   gh --version
#
#   gh auth token -h HOST [-u USER]
#     prints $FAKEGH_DIR/token-USER (with -u) or $FAKEGH_DIR/token (without)
#     and exits 0. With no such file it is signed out: it prints
#     "no oauth token found for HOST" on stderr and exits 1, as gh does.
#
#   gh pr view [PR] [-R REPO] --json FIELDS
#     the guard's lookup of a pull request. Prints $FAKEGH_DIR/pr_view.json
#     (the answer as gh prints it), or with $FAKEGH_DIR/pr_view.fail exits 1 and
#     prints that file on stderr, or with $FAKEGH_DIR/pr_view.sleep sleeps that
#     many seconds first (it execs sleep, so a killed gh dies at once). With no
#     pr_view.json it is not found: stderr says so, exit 1. --json is required.
#
#   gh pr view URL --json state
#     the moor check's lookup of one pull request by its URL (a first argument
#     that starts with https://). Prints {"state":"<STATE>"} from the file
#     $FAKEGH_DIR/pr_state/<URL with every / and : turned into _> (its content
#     is OPEN, CLOSED or MERGED). With $FAKEGH_DIR/pr_state.fail it exits 1 and
#     prints that file on stderr. A URL with no file is one GitHub cannot
#     confirm: stderr says so, exit 1. A pr view with no URL is the guard's
#     lookup above.
#
#   gh repo clone [--] REPO DIR
#     REPO is OWNER/REPO (host github.com) or HOST/OWNER/REPO. Makes DIR a git
#     checkout whose origin is https://HOST/OWNER/REPO.git, so the checkout is
#     matched to the repo by its remote. It refuses (exit 1, "fatal: destination
#     path ... already exists") when DIR exists, as git does. Steered by:
#       repo_clone.sleep   sleep that many seconds before cloning, so two clones overlap
#       repo_clone.fail    leave a partial DIR (a junk file, as an interrupted
#                          git does), print the file's content on stderr, exit 1
#
#   gh pr merge URL (--merge|--squash|--rebase) [-d|--delete-branch] [--match-head-commit SHA]
#     the Merge act's single-pull-request merge. Exactly one method flag is
#     required and the URL must be https://. Any other flag is refused (exit 2),
#     --admin and --auto above all: Admiral never bypasses a rule. On success it
#     writes MERGED into pr_state/KEY of the URL (the poll then sees the merge)
#     and exits 0. With $FAKEGH_DIR/pr_merge.fail it exits 1 and prints that file
#     on stderr, merging nothing. With $FAKEGH_DIR/pr_merge.sleep it sleeps that
#     many seconds first, so a second merge can arrive while this one runs.
#
#   gh stack merge N --yes --merge-method (merge|squash|rebase)
#     the Merge act's whole-stack merge, by GitHub's stack number: exactly one
#     positional argument, an integer (anything else exits 2). --yes and
#     --merge-method are required, so a call that could stop to ask refuses
#     (exit 2). There is no `gh stack view`: Admiral reads a stack through the
#     detail query. A number that no pr_detail/KEY fixture holds as its
#     "stack":{"number":N, exits 1 ("no stack N"). On success it merges every PR
#     whose pr_detail/KEY has that stack: it writes MERGED into pr_state/KEY and
#     rewrites each "state":"OPEN" in pr_detail/KEY to "state":"MERGED" (the
#     stack entries' too), then exits 0. The match and the rewrite read the
#     compact fixture the test helpers write: `"stack":{"number":N,` and
#     `"state":"OPEN"`, with no space after a colon. With
#     $FAKEGH_DIR/stack_merge.fail it exits 1 and prints that file on stderr,
#     merging nothing. With $FAKEGH_DIR/stack_merge.sleep it sleeps that many
#     seconds first. The call directory's cwd file is where gh ran.
#
#   gh api graphql ...   (the repository's default merge method)
#     Taken when an argument holds `viewerDefaultMergeMethod`, before the other
#     graphql matches. Prints
#     {"data":{"repository":{"viewerDefaultMergeMethod":"METHOD"}}} with METHOD
#     from $FAKEGH_DIR/default_merge_method (MERGE, SQUASH or REBASE; none:
#     MERGE). With $FAKEGH_DIR/default_merge_method.fail it exits 1 and prints
#     that file on stderr. Every merge-flavoured call also records $GH_REPO and
#     the working directory (see env and cwd above).
#
#   gh api graphql ...   (the PR tab's single-PR detail query)
#     Taken before the batched query when an argument holds `isDraft`. It reads
#     the one `d: repository(owner: "O", name: "N") { pullRequest(number: 7)`
#     and answers data.d.pullRequest with the content of $FAKEGH_DIR/pr_detail/KEY
#     (KEY as for pr_state): a JSON object in GitHub's shape, not checked against
#     the query. No file: the item-level NOT_FOUND. $FAKEGH_DIR/pr_detail.fail
#     (its content on stderr, exit 1) and $FAKEGH_DIR/pr_detail.sleep (seconds
#     to wait first) make the call fail or run long.
#
#   gh api graphql ...   (the moor poll's batched pull request query)
#     Taken when an argument holds `pullRequest(number:`, before the search
#     match below. It reads each `ALIAS: repository(owner: "O", name: "N")
#     { pullRequest(number: 7)` out of the query (literal values) and answers
#     every alias as GitHub does, under data. The PR is
#     https://HOST/O/N/pull/7 (HOST from --hostname, else github.com), keyed
#     like pr_state below. Its files, each holding one word:
#       pr_state/KEY      state: OPEN, CLOSED or MERGED. No file: NOT_FOUND.
#       pr_review/KEY     reviewDecision (none: null)
#       pr_checks/KEY     statusCheckRollup.state (none: null)
#       pr_mergeable/KEY  mergeable (none: UNKNOWN)
#       pr_events/KEY     a JSON object whose members are added to the PR's node
#                         as GitHub would return them (headRefOid, mergeStateStatus,
#                         baseRef, reviews, reviewThreads, comments, reviewRequests,
#                         timelineItems, commits). The query's own fields are not
#                         checked: what the file holds is what the client reads.
#     $FAKEGH_DIR/viewer holds the login of data.viewer (none: fake-viewer).
#       pr_notfound/KEY   any content: NOT_FOUND for this PR even with a state
#       repo_notfound/OWNER_NAME  any content: the repository itself is NOT_FOUND
#                         (the alias is null, the error's path is just the alias)
#     With a NOT_FOUND PR the answer is gh's partial one: the other PRs still
#     under data, the missing one a null pullRequest, an errors entry of type
#     NOT_FOUND, "gh: Could not resolve ..." on stderr, exit 1. With
#     $FAKEGH_DIR/pr_batch.fail the whole call fails: that file's content on
#     stderr, nothing on stdout, exit 1.
#
#   gh api graphql ...   (the search)
#     Looks for a canned search in $FAKEGH_DIR/search/: a <key>.match file
#     holds a string, and the first key (in name order) whose string appears
#     in any argument answers. Then, in this order:
#       <key>.fail   exit with <key>.exit (default 1), printing the file's
#                    content on stderr and nothing on stdout
#       <key>.json   printed on stdout, exit 0
#     No key matches: stderr says so, exit 1.
#     The answer is the GraphQL response as GitHub sends it, whole, except that
#     with $FAKEGH_DIR/viewer it also carries data.viewer.login (the file's
#     content) when the canned data object starts the answer. Items may carry
#     author and timelineItems as the query asks for them. The fake
#     does not run --jq or --template, so it refuses them (exit 2).
#
#   gh api [-X METHOD] [-f NAME=VALUE]... [--hostname HOST] [--input FILE|-] ENDPOINT
#     a REST call (ENDPOINT is not "graphql"). Like gh, the method is GET unless
#     -X/--method says otherwise, and POST when there are -f/-F fields or --input
#     and no -X. -F/--field is refused (it reads @files and types values, which
#     Admiral must never ask of an item's text), as are --jq and --template.
#     Besides argv and env, the call directory records:
#       method     the method in effect
#       endpoint   the ENDPOINT, without a leading slash
#       host       the --hostname value, if any
#       stdin      what --input - read, if given
#     A canned answer lives in $FAKEGH_DIR/rest/ as <key>.endpoint (exactly the
#     endpoint, no leading slash), optional <key>.method (default GET) and
#     optional <key>.host (the --hostname that must be given; default any).
#     The first key (in name order) that matches answers:
#       <key>.status   the HTTP status (default 200)
#       <key>.json     the body, printed on stdout (default {})
#       <key>.stderr   for a status of 300 or more, printed on stderr
#                      (default "gh: HTTP <status>"); the exit is then 1, as gh's
#     No key matches: stderr says so, exit 1.
call_dir=$(mktemp -d "$FAKEGH_DIR/calls/call.XXXXXX" 2>/dev/null) || {
	mkdir -p "$FAKEGH_DIR/calls"
	call_dir=$(mktemp -d "$FAKEGH_DIR/calls/call.XXXXXX")
}
for a in "$@"; do printf '%s\0' "$a"; done > "$call_dir/argv"
pwd -P > "$call_dir/cwd"
{
	[ -n "${GH_TOKEN+x}" ] && printf 'GH_TOKEN=%s\n' "$GH_TOKEN"
	[ -n "${GITHUB_TOKEN+x}" ] && printf 'GITHUB_TOKEN=%s\n' "$GITHUB_TOKEN"
	[ -n "${GH_ENTERPRISE_TOKEN+x}" ] && printf 'GH_ENTERPRISE_TOKEN=%s\n' "$GH_ENTERPRISE_TOKEN"
	[ -n "${GITHUB_ENTERPRISE_TOKEN+x}" ] && printf 'GITHUB_ENTERPRISE_TOKEN=%s\n' "$GITHUB_ENTERPRISE_TOKEN"
	[ -n "${GH_NO_UPDATE_NOTIFIER+x}" ] && printf 'GH_NO_UPDATE_NOTIFIER=%s\n' "$GH_NO_UPDATE_NOTIFIER"
	[ -n "${GH_PROMPT_DISABLED+x}" ] && printf 'GH_PROMPT_DISABLED=%s\n' "$GH_PROMPT_DISABLED"
	[ -n "${GH_REPO+x}" ] && printf 'GH_REPO=%s\n' "$GH_REPO"
	[ -n "${GH_HOST+x}" ] && printf 'GH_HOST=%s\n' "$GH_HOST"
	env | grep '^GIT_CONFIG_'
	[ -n "${FLEET_MARK+x}" ] && printf 'FLEET_MARK=%s\n' "$FLEET_MARK"
	[ -n "${ADMIRAL_BASE+x}" ] && printf 'ADMIRAL_BASE=%s\n' "$ADMIRAL_BASE"
	[ -n "${ADMIRAL_OVER+x}" ] && printf 'ADMIRAL_OVER=%s\n' "$ADMIRAL_OVER"
	true
} > "$call_dir/env"

case "$1" in
--version)
	echo "gh version 2.99.0 (fake)"
	exit 0
	;;
auth)
	[ "$2" = token ] || { echo "fakegh: unsupported: gh $*" >&2; exit 2; }
	shift 2
	host= user=
	while [ $# -gt 0 ]; do
		case "$1" in
		-h|--hostname) host=$2; shift 2 ;;
		-u|--user) user=$2; shift 2 ;;
		*) echo "fakegh: unsupported argument to gh auth token: $1" >&2; exit 2 ;;
		esac
	done
	file="$FAKEGH_DIR/token"
	[ -n "$user" ] && file="$FAKEGH_DIR/token-$user"
	if [ -s "$file" ]; then
		cat "$file"
		exit 0
	fi
	echo "no oauth token found for ${host:-github.com}" >&2
	exit 1
	;;
pr)
	if [ "$2" = merge ]; then
		shift 2
		prurl= method= nmethod=0
		while [ $# -gt 0 ]; do
			case "$1" in
			--merge|--squash|--rebase) method=${1#--}; nmethod=$((nmethod + 1)); shift ;;
			-d|--delete-branch) shift ;;
			--match-head-commit) shift 2 ;;
			https://*) prurl=$1; shift ;;
			*) echo "fakegh: unsupported argument to gh pr merge: $1" >&2; exit 2 ;;
			esac
		done
		[ -n "$prurl" ] || { echo "fakegh: gh pr merge needs the pull request's URL" >&2; exit 2; }
		[ "$nmethod" = 1 ] || { echo "fakegh: gh pr merge needs exactly one of --merge, --squash, --rebase" >&2; exit 2; }
		echo "$method" > "$call_dir/method"
		[ -s "$FAKEGH_DIR/pr_merge.sleep" ] && sleep "$(cat "$FAKEGH_DIR/pr_merge.sleep")"
		if [ -e "$FAKEGH_DIR/pr_merge.fail" ]; then
			cat "$FAKEGH_DIR/pr_merge.fail" >&2
			exit 1
		fi
		mkdir -p "$FAKEGH_DIR/pr_state"
		mkey=$(printf '%s' "$prurl" | tr '/:' '__')
		echo MERGED > "$FAKEGH_DIR/pr_state/$mkey"
		if [ -s "$FAKEGH_DIR/pr_detail/$mkey" ]; then
			sed 's/"state":"OPEN"/"state":"MERGED"/g' "$FAKEGH_DIR/pr_detail/$mkey" > "$call_dir/detail.tmp" && mv "$call_dir/detail.tmp" "$FAKEGH_DIR/pr_detail/$mkey"
		fi
		exit 0
	fi
	[ "$2" = view ] || { echo "fakegh: unsupported: gh $*" >&2; exit 2; }
	shift 2
	json= prurl=
	while [ $# -gt 0 ]; do
		case "$1" in
		--json) json=$2; shift 2 ;;
		-R|--repo) shift 2 ;;
		-*) echo "fakegh: unsupported argument to gh pr view: $1" >&2; exit 2 ;;
		https://*) prurl=$1; shift ;;
		*) shift ;;
		esac
	done
	[ -n "$json" ] || { echo "fakegh: gh pr view needs --json" >&2; exit 2; }
	if [ -n "$prurl" ]; then
		if [ -e "$FAKEGH_DIR/pr_state.fail" ]; then
			cat "$FAKEGH_DIR/pr_state.fail" >&2
			exit 1
		fi
		stfile="$FAKEGH_DIR/pr_state/$(printf '%s' "$prurl" | tr '/:' '__')"
		if [ -s "$stfile" ]; then
			printf '{"state":"%s"}\n' "$(cat "$stfile")"
			exit 0
		fi
		echo "fakegh: no canned state for $prurl" >&2
		exit 1
	fi
	[ -s "$FAKEGH_DIR/pr_view.sleep" ] && exec sleep "$(cat "$FAKEGH_DIR/pr_view.sleep")"
	if [ -e "$FAKEGH_DIR/pr_view.fail" ]; then
		cat "$FAKEGH_DIR/pr_view.fail" >&2
		exit 1
	fi
	if [ -e "$FAKEGH_DIR/pr_view.json" ]; then
		cat "$FAKEGH_DIR/pr_view.json"
		exit 0
	fi
	echo "fakegh: no canned pr view" >&2
	exit 1
	;;
stack)
	[ "$2" = merge ] || { echo "fakegh: unsupported: gh $*" >&2; exit 2; }
	shift 2
	yes=0 method= target= ntarget=0
	while [ $# -gt 0 ]; do
		case "$1" in
		--yes|-y) yes=1; shift ;;
		--merge-method) method=$2; shift 2 ;;
		--merge-method=*) method=${1#--merge-method=}; shift ;;
		-*) echo "fakegh: unsupported argument to gh stack merge: $1" >&2; exit 2 ;;
		*) target=$1; ntarget=$((ntarget + 1)); shift ;;
		esac
	done
	[ "$ntarget" = 1 ] || { echo "fakegh: gh stack merge takes exactly one stack number, got $ntarget arguments" >&2; exit 2; }
	case "$target" in
	''|*[!0-9]*) echo "fakegh: gh stack merge takes a stack number, got $target" >&2; exit 2 ;;
	esac
	[ "$yes" = 1 ] || { echo "fakegh: gh stack merge without --yes would stop to ask" >&2; exit 2; }
	case "$method" in
	merge|squash|rebase) ;;
	*) echo "fakegh: gh stack merge needs --merge-method merge, squash or rebase" >&2; exit 2 ;;
	esac
	echo "$method" > "$call_dir/method"
	members=
	for f in "$FAKEGH_DIR"/pr_detail/*; do
		[ -s "$f" ] || continue
		grep -qE "\"stack\": *\{ *\"number\": *$target *[,}]" "$f" && members="$members $(basename "$f")"
	done
	[ -n "$members" ] || { echo "fakegh: no stack $target" >&2; exit 1; }
	[ -s "$FAKEGH_DIR/stack_merge.sleep" ] && sleep "$(cat "$FAKEGH_DIR/stack_merge.sleep")"
	if [ -e "$FAKEGH_DIR/stack_merge.fail" ]; then
		cat "$FAKEGH_DIR/stack_merge.fail" >&2
		exit 1
	fi
	mkdir -p "$FAKEGH_DIR/pr_state"
	for k in $members; do
		echo MERGED > "$FAKEGH_DIR/pr_state/$k"
		sed 's/"state":"OPEN"/"state":"MERGED"/g' "$FAKEGH_DIR/pr_detail/$k" > "$call_dir/detail.tmp" && mv "$call_dir/detail.tmp" "$FAKEGH_DIR/pr_detail/$k"
	done
	exit 0
	;;
repo)
	[ "$2" = clone ] || { echo "fakegh: unsupported: gh $*" >&2; exit 2; }
	shift 2
	[ "$1" = -- ] && shift
	repo=$1 dir=$2
	[ -n "$repo" ] && [ -n "$dir" ] || { echo "fakegh: gh repo clone needs REPO and DIR" >&2; exit 2; }
	[ -s "$FAKEGH_DIR/repo_clone.sleep" ] && sleep "$(cat "$FAKEGH_DIR/repo_clone.sleep")"
	if [ -e "$dir" ]; then
		echo "fatal: destination path '$dir' already exists and is not an empty directory." >&2
		exit 1
	fi
	if [ -e "$FAKEGH_DIR/repo_clone.fail" ]; then
		mkdir -p "$dir"
		echo partial > "$dir/partial"
		cat "$FAKEGH_DIR/repo_clone.fail" >&2
		exit 1
	fi
	case "$repo" in
	*/*/*) url="https://$repo.git" ;;
	*) url="https://github.com/$repo.git" ;;
	esac
	mkdir -p "$dir"
	git -C "$dir" init -q && git -C "$dir" remote add origin "$url" || exit 1
	exit 0
	;;
api)
	for a in "$@"; do
		case "$a" in
		--jq|-q|--template|-t|--jq=*|--template=*) echo "fakegh: $a is not supported; read the whole response" >&2; exit 2 ;;
		esac
	done
	if [ "$2" != graphql ]; then
		shift
		method= endpoint= host= input= fields=
		while [ $# -gt 0 ]; do
			case "$1" in
			-X|--method) method=$2; shift 2 ;;
			-f|--raw-field) fields="$fields $2"; shift 2 ;;
			--hostname) host=$2; shift 2 ;;
			--input) input=$2; shift 2 ;;
			-H|--header) shift 2 ;;
			-F|--field) echo "fakegh: $1 is not supported; pass item text with -f" >&2; exit 2 ;;
			-*) echo "fakegh: unsupported argument to gh api: $1" >&2; exit 2 ;;
			*) [ -z "$endpoint" ] || { echo "fakegh: two endpoints: $endpoint and $1" >&2; exit 2; }
			   endpoint=${1#/}; shift ;;
			esac
		done
		if [ -z "$method" ]; then
			method=GET
			{ [ -n "$fields" ] || [ -n "$input" ]; } && method=POST
		fi
		printf '%s\n' "$method" > "$call_dir/method"
		printf '%s\n' "$endpoint" > "$call_dir/endpoint"
		[ -n "$host" ] && printf '%s\n' "$host" > "$call_dir/host"
		if [ "$input" = - ]; then
			cat > "$call_dir/stdin"
		elif [ -n "$input" ]; then
			cp "$input" "$call_dir/stdin"
		fi
		for e in "$FAKEGH_DIR"/rest/*.endpoint; do
			[ -e "$e" ] || continue
			key=${e%.endpoint}
			[ "$(cat "$e")" = "$endpoint" ] || continue
			want=GET
			[ -s "$key.method" ] && want=$(cat "$key.method")
			[ "$want" = "$method" ] || continue
			if [ -s "$key.host" ] && [ "$(cat "$key.host")" != "$host" ]; then continue; fi
			status=200
			[ -s "$key.status" ] && status=$(cat "$key.status")
			if [ -e "$key.json" ]; then cat "$key.json"; else echo '{}'; fi
			if [ "$status" -ge 300 ]; then
				if [ -e "$key.stderr" ]; then cat "$key.stderr" >&2; else echo "gh: HTTP $status" >&2; fi
				exit 1
			fi
			exit 0
		done
		echo "fakegh: no canned REST answer for $method $endpoint" >&2
		exit 1
	fi
	for a in "$@"; do
		case "$a" in
		*viewerDefaultMergeMethod*)
			if [ -e "$FAKEGH_DIR/default_merge_method.fail" ]; then
				cat "$FAKEGH_DIR/default_merge_method.fail" >&2
				exit 1
			fi
			dm=MERGE
			[ -s "$FAKEGH_DIR/default_merge_method" ] && dm=$(cat "$FAKEGH_DIR/default_merge_method")
			printf '{"data":{"repository":{"viewerDefaultMergeMethod":"%s"}}}\n' "$dm"
			exit 0
			;;
		esac
	done
	for a in "$@"; do
		case "$a" in
		*isDraft*)
			[ -s "$FAKEGH_DIR/pr_detail.sleep" ] && sleep "$(cat "$FAKEGH_DIR/pr_detail.sleep")"
			if [ -e "$FAKEGH_DIR/pr_detail.fail" ]; then
				cat "$FAKEGH_DIR/pr_detail.fail" >&2
				exit 1
			fi
			dhost=github.com dprev=
			for b in "$@"; do
				[ "$dprev" = --hostname ] && dhost=$b
				dprev=$b
			done
			dent=$(printf '%s' "$a" | tr -d '\n' | grep -oE 'repository\(owner: *"[^"]+", *name: *"[^"]+"\) *\{ *pullRequest\(number: *[0-9]+\)' | head -1 |
				sed -E 's/^repository\(owner: *"([^"]+)", *name: *"([^"]+)"\) *\{ *pullRequest\(number: *([0-9]+)\)$/\1 \2 \3/')
			read -r downer dname dnum <<EOF3
$dent
EOF3
			dkey=$(printf '%s' "https://$dhost/$downer/$dname/pull/$dnum" | tr '/:' '__')
			if [ -s "$FAKEGH_DIR/pr_detail/$dkey" ]; then
				printf '{"data":{"d":{"pullRequest":%s}}}\n' "$(tr -d '\n' <"$FAKEGH_DIR/pr_detail/$dkey")"
				exit 0
			fi
			printf '{"data":{"d":{"pullRequest":null}},"errors":[{"type":"NOT_FOUND","path":["d","pullRequest"],"message":"Could not resolve to a PullRequest with the number of %s."}]}\n' "$dnum"
			echo "gh: Could not resolve to a PullRequest" >&2
			exit 1
			;;
		esac
	done
	batch=
	bhost=github.com
	prev=
	for a in "$@"; do
		case "$a" in
		*"pullRequest(number:"*) batch=$a ;;
		esac
		[ "$prev" = --hostname ] && bhost=$a
		prev=$a
	done
	if [ -n "$batch" ]; then
		if [ -e "$FAKEGH_DIR/pr_batch.fail" ]; then
			cat "$FAKEGH_DIR/pr_batch.fail" >&2
			exit 1
		fi
		data= errs= missing=0
		entries=$(printf '%s' "$batch" | tr -d '\n' | grep -oE '[A-Za-z0-9_]+: *repository\(owner: *"[^"]+", *name: *"[^"]+"\) *\{ *pullRequest\(number: *[0-9]+\)' |
			sed -E 's/^([A-Za-z0-9_]+): *repository\(owner: *"([^"]+)", *name: *"([^"]+)"\) *\{ *pullRequest\(number: *([0-9]+)\)$/\1 \2 \3 \4/')
		while read -r alias owner name num; do
			[ -n "$alias" ] || continue
			key=$(printf '%s' "https://$bhost/$owner/$name/pull/$num" | tr '/:' '__')
			if [ -e "$FAKEGH_DIR/repo_notfound/${owner}_$name" ]; then
				missing=1
				errs="$errs${errs:+,}{\"type\":\"NOT_FOUND\",\"path\":[\"$alias\"],\"message\":\"Could not resolve to a Repository with the name '$owner/$name'.\"}"
				data="$data${data:+,}\"$alias\":null"
				continue
			fi
			if [ -e "$FAKEGH_DIR/pr_notfound/$key" ] || [ ! -s "$FAKEGH_DIR/pr_state/$key" ]; then
				node='null'
				missing=1
				errs="$errs${errs:+,}{\"type\":\"NOT_FOUND\",\"path\":[\"$alias\",\"pullRequest\"],\"message\":\"Could not resolve to a PullRequest with the number of $num.\"}"
			else
				st=$(cat "$FAKEGH_DIR/pr_state/$key")
				rv=null ck=null mg='"UNKNOWN"'
				[ -s "$FAKEGH_DIR/pr_review/$key" ] && rv="\"$(cat "$FAKEGH_DIR/pr_review/$key")\""
				[ -s "$FAKEGH_DIR/pr_checks/$key" ] && ck="{\"state\":\"$(cat "$FAKEGH_DIR/pr_checks/$key")\"}"
				[ -s "$FAKEGH_DIR/pr_mergeable/$key" ] && mg="\"$(cat "$FAKEGH_DIR/pr_mergeable/$key")\""
				extra=
				if [ -s "$FAKEGH_DIR/pr_events/$key" ]; then
					extra=",$(tr -d '\n' <"$FAKEGH_DIR/pr_events/$key" | sed -E 's/^[[:space:]]*\{//; s/\}[[:space:]]*$//')"
				fi
				node="{\"state\":\"$st\",\"reviewDecision\":$rv,\"mergeable\":$mg,\"statusCheckRollup\":$ck$extra}"
			fi
			data="$data${data:+,}\"$alias\":{\"pullRequest\":$node}"
		done <<EOF2
$entries
EOF2
		viewer=fake-viewer
		[ -s "$FAKEGH_DIR/viewer" ] && viewer=$(cat "$FAKEGH_DIR/viewer")
		data="$data${data:+,}\"viewer\":{\"login\":\"$viewer\"}"
		if [ "$missing" = 1 ]; then
			printf '{"data":{%s},"errors":[%s]}\n' "$data" "$errs"
			echo "gh: Could not resolve to a PullRequest" >&2
			exit 1
		fi
		printf '{"data":{%s}}\n' "$data"
		exit 0
	fi
	for m in "$FAKEGH_DIR"/search/*.match; do
		[ -e "$m" ] || continue
		key=${m%.match}
		needle=$(cat "$m")
		for a in "$@"; do
			case "$a" in
			*"$needle"*)
				if [ -e "$key.fail" ]; then
					cat "$key.fail" >&2
					code=1
					[ -s "$key.exit" ] && code=$(cat "$key.exit")
					exit "$code"
				fi
				if [ -s "$FAKEGH_DIR/viewer" ]; then
					sed "s/^{\"data\":{/{\"data\":{\"viewer\":{\"login\":\"$(cat "$FAKEGH_DIR/viewer")\"},/" "$key.json"
				else
					cat "$key.json"
				fi
				exit 0
				;;
			esac
		done
	done
	echo "fakegh: no canned search matches this call" >&2
	exit 1
	;;
*)
	echo "fakegh: unsupported: gh $*" >&2
	exit 2
	;;
esac
